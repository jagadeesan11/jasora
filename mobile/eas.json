{
  "cli": {
    "version": ">=13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "resourceClass": "medium"
      },
      "ios": {
        "resourceClass": "medium",
        "simulator": true
      }
    },
    "preview": {
      "extends": "development",
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "resourceClass": "medium",
        // Play Store requires an App Bundle, not an APK. This is already the
        // default for distribution "store", but stated explicitly so the
        // store artifact never depends on a default quietly changing.
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        // Service account key from Google Cloud project jasora-508110. Read
        // from the local machine at submit time, never uploaded with a build
        // (see .easignore) and never committed (see mobile/.gitignore).
        "serviceAccountKeyPath": "./jasora-508110-d29361e22a79.json",
        // First stop for every release. Promote to production from the Play
        // Console once the internal testers have had it.
        "track": "internal"
      }
    }
  }
}
