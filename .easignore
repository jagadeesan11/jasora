# EAS Build archives from the GIT REPOSITORY ROOT — this directory — not from
# mobile/. A .easignore placed inside mobile/ is never read, which is why the
# first two builds shipped 386 MB and 570 MB archives: both workspaces'
# node_modules travelled with them.
#
# EAS installs dependencies itself, and the mobile build needs nothing from
# the admin or supabase workspaces.

**/node_modules/

# Sibling workspaces the mobile build never reads.
admin/
supabase/

# Build output and local caches.
**/.expo/
**/dist/
**/web-build/
**/.next/
**/coverage/

# Editor and tooling noise.
.idea/
.claude/
*.log
.DS_Store

# Service-account keys. `eas submit` reads the Play key from this machine, so
# no credential ever needs to travel to the build servers inside the archive.
mobile/*-service-account*.json
mobile/nexora-*-*.json
mobile/jasora-*-*.json
mobile/google-play-*.json

# Signing keystores and the plaintext credentials.json that `eas credentials`
# can write next to them. EAS signs on its own servers from the copy it holds.
mobile/*.jks
mobile/*.p12
mobile/credentials.json
